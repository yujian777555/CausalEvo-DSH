  "known_defects": [
    {
      "consequence": "cea_v2, cea_v2_no_context and cea_v2_single_objective are truncated to a 15-episode prefix in all regimes; their cumulative metrics cover only that prefix and are NOT comparable to full-horizon arms — compare regret_per_behavioral_episode and success_rate only, and treat the livelock itself as the validation's primary finding.",
      "id": "CEA-V2-D1",
      "mechanism": "offspring generation loops until n_offspring NOVEL phenotypes are found; unmeasured offspring are protected from eviction forever; once per-context incumbents score above the exploration bonus (0.55) offspring stop being measured, so free phenotype slots drain monotonically. Under the frozen defaults (update_every=4, n_offspring=4, max_population=16) the 4th evolve — behavioral observation 16 — cannot terminate.",
      "reproduction": "run scripts/run_cea_v2_offline.py: every evolving arm is truncated by the structural guard at episode 15 in every regime (guard precondition: unique phenotypes > 16 - n_offspring at evolve time).",
      "severity": "blocking for long-horizon online operation",
      "summary": "OnlineEvolutionController._evolve() livelocks once the population holds more than 16 - n_offspring of the 16 possible effective phenotypes."
    }
  ],
  "note": "Synthetic regimes are mechanism tests ONLY: they exercise selection/observation/update/evolution wiring under controlled reward tables. They are NOT evidence of real-agent improvement, algorithm generalization, or NSGA-III superiority on real tasks. No real model was invoked anywhere in this run.",
  "real_agent_improvement_evidence": false,
  "regimes": {
    "abrupt_shift": {
      "description": "abrupt reward+context shift at episode 8: the tool context's best effective phenotype flips from the tool bundle (T,R,B) to the verification phenotype (T,V) among frozen-front members — the unconstrained post-shift oracle is the singleton (V,) — and the context mix becomes tool-heavy. The shift is placed early on purpose: under frozen defaults the CEA-v2 controller livelocks at behavioral observation 16 (see known_defects), so only an early shift leaves a post-shift window inside the controller's maximum viable horizon; frozen arms demonstrate the full 232-episode post-shift regret.",
      "n_episodes": 240,
      "shift_at": 8
    },
    "iid_noise": {
      "description": "negative control: i.i.d. Bernoulli(0.45) rewards with identical cost/calls for every phenotype in every context. There is no signal; any adaptation is overfitting and should NOT win.",
      "n_episodes": 160,
      "shift_at": null
    },
    "stationary_contextual": {
      "description": "stationary context-conditioned rewards; each failure_type has a distinct best effective phenotype",
      "n_episodes": 160,
      "shift_at": null
    },
    "success_cost_tradeoff": {
      "description": "context-dependent success/cost trade-off: in the verification context the success-argmax phenotype (tool+verification genes) is expensive (verification transform cost x4, +1 call) while the lambda-scalarized argmax is the cheaper tool bundle; the tool context is unambiguous.",
      "n_episodes": 160,
      "shift_at": null
    }
  },
