# --- secrets & credentials ---
.env
.env.*
*.key
*.pem
*secret*
*token*

# --- python ---
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/

# --- harness runtime state (isolated benchmark home; may contain raw session logs) ---
.dsh-bench/
dsh_home/
results/**/dsh_home/
results/**/workspace/

# --- raw / oversized logs ---
*.log
logs/
# raw harness session logs stay local; redacted-by-construction eval traces may be committed
*.jsonl
!results/phase1/**/traces.jsonl

# --- benchmark scratch ---
results/phase0/tmp/
results/phase1/r2-scratch/
.pytest_cache/
